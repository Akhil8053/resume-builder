# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=securecv_super_secret_jwt_key_2026_cybersecurity_grade_btech

# Brute-Force Rate Limiting Policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Firebase Backend Configuration (Firebase Admin SDK)
# Obtain from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# ============================================================================
# Option 1: File path to downloaded serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# Option 2: Individual environment variables (Preferred for Vercel / Cloud deployments)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ============================================================================
# Firebase Frontend Public Configuration (Firebase Web SDK)
# Obtain from: Firebase Console > Project Settings > General > Your apps (Web app)
# ============================================================================
FIREBASE_API_KEY=AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxxxxxxxxxxx

# Local SQLite Backup (Kept for offline verification / local viva defense)
DB_FILE=db/securecv.sqlite
